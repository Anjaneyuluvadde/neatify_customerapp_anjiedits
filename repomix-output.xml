  onBookNow?: () => void;
}

interface Feature {
  icon: string;
  iconFamily: 'Ionicons' | 'MaterialCommunityIcons';
  title: string;
  description: string;
}

interface WhyChooseUsData {
  title: string;
  subtitle: string;
  features: Feature[];
  bottom_title: string;
  bottom_desc: string;
  bottom_button_text: string;
}

